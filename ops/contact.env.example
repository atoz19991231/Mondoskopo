# TEMPLATE ONLY. Do not place real addresses or tokens in GitHub.
# On Netcup create /etc/mondoskopo/contact.env, owned by root, mode 0600.
# Get SMTP token via Proton Settings > All settings > IMAP/SMTP > SMTP tokens.
# This must be a Mondoskopo custom-domain Proton sender address.
MONDOSKOPO_SMTP_USER=YOUR_CUSTOM_DOMAIN_PROTON_ADDRESS
MONDOSKOPO_SMTP_TOKEN=YOUR_PRIVATE_PROTON_SMTP_TOKEN
MONDOSKOPO_CONTACT_TO=YOUR_PRIVATE_RECIPIENT_ADDRESS
