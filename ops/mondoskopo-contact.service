[Unit]
Description=Mondoskopo private contact-form SMTP relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=desadmin
Group=desadmin
WorkingDirectory=/home/desadmin/mondoskopo-deploy/site
EnvironmentFile=/etc/mondoskopo/contact.env
ExecStart=/usr/bin/python3 /home/desadmin/mondoskopo-deploy/site/ops/contact_api.py
Restart=on-failure
RestartSec=8
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
LimitNOFILE=1024

[Install]
WantedBy=multi-user.target
